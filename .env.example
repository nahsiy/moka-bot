# Créer une application de test ; ne jamais publier son token.
DISCORD_TOKEN=
# Identifiants des seuls serveurs où Moka peut agir (séparés par des virgules).
MOKA_GUILD_IDS=
MOKA_CONFIG=config.example.toml
MOKA_DATA_DIR=data
# Une synchronisation explicite, limitée aux serveurs ci-dessus.
MOKA_SYNC_COMMANDS=0
